# --- Required. The service refuses to start if any of these are missing. ---

# Anthropic API key, used to draft posts. https://platform.claude.com/
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric id of the Telegram chat that receives drafts (your private chat with
# the bot). Send /id to the bot to discover it.
TELEGRAM_CHAT_ID=

# Buffer API access token. https://publish.buffer.com/ -> account -> apps.
BUFFER_ACCESS_TOKEN=

# Id of the connected X profile in Buffer (GET /1/profiles.json to list them).
BUFFER_PROFILE_ID=

# --- Optional ---

# Route ALL outbound traffic (Telegram, GitHub, Zenodo, Anthropic, Buffer)
# through a local proxy/VPN, e.g. http://127.0.0.1:7897 for Clash. Leave empty
# where the network reaches these services directly (e.g. on Render).
PROXY_URL=

# GitHub token. Not needed for a public repo, but raises the API rate limit.
GITHUB_TOKEN=

# Repo to watch. Defaults to hasan-mavlonov/mindform_v0.
GITHUB_REPO=

# Zenodo community slug: the last part of your community URL, e.g.
# https://zenodo.org/communities/mindform-ai -> mindform-ai (the default).
ZENODO_COMMUNITY=

# Which sources auto-draft. Commits default to false (noisy on an active
# repo); generate commit posts on demand from /menu instead.
WATCH_COMMITS=
WATCH_RELEASES=
WATCH_ZENODO=

# How often to check the sources, in minutes. Defaults to 180 (3 hours).
CHECK_INTERVAL_MINUTES=

# Claude model used for drafting. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# Path of the SQLite state file. Defaults to ./posting_automation.db.
DB_PATH=

# On the very first run per source, existing history is marked as seen without
# drafting posts, so you don't get spammed with the whole backlog. Set to true
# to draft the backlog instead.
PROCESS_BACKLOG_ON_FIRST_RUN=

# Cap on new items drafted per source per cycle. Defaults to 10; the rest are
# picked up on the next cycle.
MAX_ITEMS_PER_CYCLE=
